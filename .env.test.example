# Entorn per a `npm test` (node --env-file=.env.test --test). Copia aquest
# fitxer a .env.test i ajusta-ho si cal — .env.test està a .gitignore.
#
# Apunta al servei "db-test" de docker-compose.local.yml (docker compose -f
# docker-compose.local.yml up -d), NO al servei "db" que ja fas servir per
# desenvolupament manual: és una BD completament separada (contenidor, port
# i volum propis) perquè els tests la puguin truncar/recrear sense por sense
# arriscar mai les dades que tens per provar coses a mà.
DATABASE_URL=postgresql://portal_ventes:portal_ventes_local@localhost:55433/portal_ventes
PGSSLMODE=disable
